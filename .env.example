# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# SQL Server connection used by src/db.py / src/config.py (via pyodbc)
OEMS_DB_SERVER=localhost
OEMS_DB_NAME=oems
OEMS_DB_DRIVER={ODBC Driver 17 for SQL Server}

# Option A: SQL Server login
OEMS_DB_USER=sa
OEMS_DB_PASSWORD=change-me

# Option B: Windows Authentication instead of a SQL login.
# If set to "yes", OEMS_DB_USER / OEMS_DB_PASSWORD above are ignored.
OEMS_DB_TRUSTED_CONNECTION=no
